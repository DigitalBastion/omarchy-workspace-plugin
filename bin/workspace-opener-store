#!/usr/bin/env python3
"""Filesystem and durable state helper for Workspace Opener.

The QML shell sends one JSON object on stdin and receives one JSON object on
stdout. Diagnostics are intentionally reserved for stderr.
"""

import fcntl
import glob
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

VERSION = 1
APP = "workspace-opener"
EDITOR_IDS = ("default", "code", "cursor")


def xdg_path(variable, fallback):
    return Path(os.environ.get(variable) or fallback) / "omarchy" / APP


def paths():
    home = Path(os.environ.get("HOME") or Path.home())
    return (
        xdg_path("XDG_CONFIG_HOME", str(home / ".config")) / "config.json",
        xdg_path("XDG_STATE_HOME", str(home / ".local" / "state")) / "history.json",
    )


def error(message):
    return {"version": VERSION, "error": message}


def read_json(path, default):
    if not path.exists():
        return default, ""
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return default, "Cannot read " + str(path) + ": " + str(exc)
    if not isinstance(value, dict) or value.get("version", VERSION) != VERSION:
        return default, "Unsupported data in " + str(path)
    return value, ""


def atomic_write(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    descriptor, temporary = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, ensure_ascii=False, separators=(",", ":"))
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def locked_update(path, mutate):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_path = path.with_suffix(path.suffix + ".lock")
    with open(lock_path, "a+", encoding="utf-8") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        data, problem = read_json(path, {"version": VERSION, "entries": {}, "sequence": 0})
        if problem:
            return None, problem
        result = mutate(data)
        atomic_write(path, data)
        return result, ""


def configured_folders(preferences):
    legacy_base = os.path.abspath(os.environ.get("WORKSPACE_OPENER_PROJECTS") or str(Path.home() / "Projects"))
    raw = preferences.get("folders")
    if raw is None:
        return [legacy_base + "/*/*"], legacy_base
    if not isinstance(raw, list) or not raw or not all(isinstance(path, str) and path.strip() for path in raw):
        raise ValueError("'folders' must be a non-empty list of paths")
    return [os.path.expanduser(path) for path in raw], legacy_base


def split_layout(path):
    try:
        visible = [entry for entry in os.scandir(path) if not entry.name.startswith(".")]
    except OSError:
        visible = []
    names = {entry.name for entry in visible}
    return names == {"src", "output"} and all(
        entry.is_dir(follow_symlinks=False) and not entry.is_symlink() for entry in visible
    )


def scan_projects(preferences):
    patterns, legacy_base = configured_folders(preferences)
    projects = []
    seen_paths = set()
    legacy_pattern = os.path.abspath(legacy_base + "/*/*")

    for source_index, pattern in enumerate(patterns):
        has_glob = glob.has_magic(pattern)
        matches = glob.glob(pattern) if has_glob else [pattern]
        for match in sorted(matches, key=str.casefold):
            if not os.path.isdir(match) or os.path.islink(match) or not os.access(match, os.R_OK | os.X_OK):
                continue
            root = os.path.realpath(os.path.abspath(match))
            if root in seen_paths:
                continue
            seen_paths.add(root)
            parent = Path(root).parent.name if has_glob else ""
            project = Path(root).name
            legacy_id = parent + "/" + project if os.path.abspath(pattern) == legacy_pattern else ""
            is_split_layout = split_layout(root)
            projects.append({
                "id": "path:" + root,
                "legacyId": legacy_id,
                "group": parent,
                "project": project,
                "rootPath": root,
                "launchPath": os.path.join(root, "src") if is_split_layout else root,
                "opens": "src" if is_split_layout else "",
                "sourceOrder": source_index,
            })
    return sorted(projects, key=lambda item: (item["sourceOrder"], item["group"].casefold(), item["project"].casefold()))


def editor_label(command):
    name = Path(command).name.lower()
    return {
        "code": "VS Code",
        "cursor": "Cursor",
        "nvim": "Neovim",
        "vim": "Vim",
        "nano": "Nano",
        "micro": "Micro",
        "hx": "Helix",
        "helix": "Helix",
    }.get(name, Path(command).name or "Omarchy default")


def default_editor_choice():
    command = "nvim"
    try:
        result = subprocess.run(["omarchy-default-editor"], capture_output=True, text=True, check=True, timeout=2)
        candidate = result.stdout.strip().splitlines()[0] if result.stdout.strip() else ""
        if candidate:
            command = candidate
    except (OSError, subprocess.SubprocessError):
        pass
    executable = shutil.which(command) or command
    return {"id": "default", "label": editor_label(command), "executable": os.path.realpath(executable)}


def editor_choices(preferences):
    raw = preferences.get("editors", ["default", "code", "cursor"])
    requested = raw if isinstance(raw, list) else []
    ids = []
    for value in requested:
        editor_id = str(value)
        if editor_id in EDITOR_IDS and editor_id not in ids:
            ids.append(editor_id)
    if not ids:
        ids = ["default"]

    choices_by_id = {
        "code": {"id": "code", "label": "VS Code", "executable": os.path.realpath(shutil.which("code") or "code")},
        "cursor": {"id": "cursor", "label": "Cursor", "executable": os.path.realpath(shutil.which("cursor") or "cursor")},
    }
    if "default" in ids:
        choices_by_id["default"] = default_editor_choice()
    choices = []
    executables = set()
    for editor_id in ids:
        choice = choices_by_id[editor_id]
        if choice["executable"] in executables:
            continue
        executables.add(choice["executable"])
        choices.append({"id": choice["id"], "label": choice["label"]})
    return choices or [{"id": "default", "label": "Omarchy default"}]


def prune_history(history, project_ids):
    entries = history.get("entries")
    if not isinstance(entries, dict):
        history["entries"] = {}
        return True
    changed = False
    for project_id in list(entries):
        if project_id not in project_ids:
            del entries[project_id]
            changed = True
    return changed


def migrate_legacy_history(history, projects):
    entries = history.get("entries")
    if not isinstance(entries, dict):
        return
    claims = {}
    for project in projects:
        legacy_id = project.get("legacyId")
        if legacy_id:
            claims.setdefault(legacy_id, []).append(project["id"])
    for legacy_id, project_ids in claims.items():
        if len(project_ids) != 1 or legacy_id not in entries:
            continue
        project_id = project_ids[0]
        if project_id not in entries:
            entries[project_id] = entries[legacy_id]
        del entries[legacy_id]


def snapshot():
    config_path, history_path = paths()
    preferences, config_problem = read_json(config_path, {"version": VERSION, "editor": "default", "dimBackdrop": False})
    if config_problem:
        return error(config_problem)
    try:
        projects = scan_projects(preferences)
    except ValueError as exc:
        return error(str(exc))
    ids = {project["id"] for project in projects}

    def update(history):
        migrate_legacy_history(history, projects)
        prune_history(history, ids)
        return history

    history, history_problem = locked_update(history_path, update)
    if history_problem:
        return error(history_problem)
    return {
        "version": VERSION,
        "projects": projects,
        "preferences": preferences,
        "editorChoices": editor_choices(preferences),
        "history": history,
    }


def mutate_history(request):
    _, history_path = paths()
    action = request.get("action")
    project_id = request.get("id")
    if not isinstance(project_id, str) or not project_id:
        return error("A project id is required")

    def update(history):
        entries = history.setdefault("entries", {})
        if not isinstance(entries, dict):
            history["entries"] = entries = {}
        sequence = int(history.get("sequence", 0))
        entry = entries.get(project_id, {})
        if action == "record":
            sequence += 1
            history["sequence"] = sequence
            entry["count"] = max(0, int(entry.get("count", 0))) + 1
            entry["lastLaunchSeq"] = sequence
            entry["lastOpenedAt"] = datetime.now(timezone.utc).isoformat()
            entry.pop("dismissed", None)
            entries[project_id] = entry
        elif action == "dismiss":
            section = request.get("section")
            if section not in ("Recent", "Most Used"):
                raise ValueError("Unknown history section")
            dismissed = entry.setdefault("dismissed", {})
            dismissed["recent" if section == "Recent" else "mostUsed"] = int(entry.get("lastLaunchSeq", sequence))
            entries[project_id] = entry
        else:
            raise ValueError("Unknown history action")
        return history

    try:
        history, problem = locked_update(history_path, update)
    except (TypeError, ValueError) as exc:
        return error(str(exc))
    if problem:
        return error(problem)
    return {"version": VERSION, "history": history}


def terminal_name():
    try:
        result = subprocess.run(["xdg-terminal-exec", "--print-path"], capture_output=True, text=True, check=True, timeout=2)
        desktop = Path(result.stdout.strip())
        for line in desktop.read_text(encoding="utf-8").splitlines():
            if line.startswith("Name="):
                return {"version": VERSION, "name": line[5:].strip() or "Default terminal"}
    except (OSError, subprocess.SubprocessError):
        pass
    return {"version": VERSION, "name": "Default terminal"}


def main():
    action = sys.argv[1] if len(sys.argv) == 2 else ""
    try:
        request = json.loads(sys.stdin.readline())
        if not isinstance(request, dict):
            raise ValueError("Request must be an object")
    except (ValueError, json.JSONDecodeError) as exc:
        print(json.dumps(error("Invalid request: " + str(exc))), flush=True)
        return 2
    if action == "snapshot": response = snapshot()
    elif action == "history": response = mutate_history(request)
    elif action == "terminal-name": response = terminal_name()
    else: response = error("Unknown action")
    print(json.dumps(response, ensure_ascii=False, separators=(",", ":")), flush=True)
    return 0 if "error" not in response else 1


if __name__ == "__main__":
    sys.exit(main())
